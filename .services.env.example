# Copy to .services.env and replace all placeholder tokens/passwords.
# Use URL-safe random values. This file is for local Compose deployment.
UW_GATEWAY_TOKEN=replace-with-a-long-random-client-token
UW_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
UW_DB_PASSWORD=replace-with-a-url-safe-random-password
UW_CASE_HOST_PATH=../data/cases/Financial Evaluation
UW_REFERENCE_HOST_PATH=../data/references
# Provider credentials go only to extraction. Existing .env is never baked in.
UW_PROVIDER_ENV_FILE=/absolute/path/outside/repository/provider-settings.env
# provider-settings.env can contain nonsecret vault settings:
# UW_KEY_VAULT_URL=https://your-vault.vault.azure.net
# UW_KEY_VAULT_SECRET_ALIASES={"AZURE_CLAUDE_API_KEY":"azure-claude-api-key"}
