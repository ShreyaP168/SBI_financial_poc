# Choose one backend
LLM_BACKEND=azure_claude

# Azure Claude (preferred)
AZURE_CLAUDE_ENDPOINT=https://kaiseries-claude-resource.services.ai.azure.com/anthropic/
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_DEPLOYMENT=claude-sonnet-4-6
AZURE_API_VERSION=2025-04-01-preview

# Anthropic direct (fallback)
ANTHROPIC_API_KEY=

# Concurrency / rate limiting
MAX_CONCURRENT_LLM=5
LLM_MAX_RETRIES=5
LLM_TOKEN_BUDGET_PER_CASE=200000

# ── SBI bureau data sources (Financial UW POC) ────────────────────
# Scores.xlsx: one sheet per case_id (DRC Category / CIBIL SCORE / Profile
# Score). IIB docx: one case_id label + 2 screenshot images per case.
# Both live in reference_docs/ (gitignored — not part of the pipeline code).
# Absent mandatory evidence prevents decision delivery.
SBI_SCORES_XLSX=../data/references/Scores.xlsx
SBI_IIB_DOCX=../data/references/IIB, prev insurance.docx
# Later batches whose Scores/IIB data arrives already-structured (one
# tabular sheet; a real xlsx table instead of screenshots) use these
# instead/in addition — see engine/scores_xlsx.py, engine/sbi_iib_xlsx.py.
SBI_SCORES_XLSX_TABULAR=
SBI_IIB_XLSX=


# Shared paths and explicit development secrets (outside Git)
UW_DATA_ROOT=../data
UW_DEV_ENV_FILE=../.local-secrets/uw_engine_v9.env
