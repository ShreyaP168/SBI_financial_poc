  "gating": {
    "graduate_min_income": 500000,
    "tsar_2cr_min_income": 750000,
    "_sa_tier_min_income_comment": "SA-tier income floor — minimum verified annual income required at each Sum Assured band. Mirrors Term UW Feb-2026 page 4 (Non-Grad column = conservative ceiling so we don't under-gate when education is unknown). Each entry: {sa_max_inr, min_income_inr}. Bands evaluated bottom-up; first band with sa_max >= proposed_sa wins.",
    "sa_tier_min_income": [
      {"sa_max_inr":   9999999,  "min_income_inr":  500000,  "label": "Up to ₹1 Cr SA → ₹5L min income"},
      {"sa_max_inr":   20000000, "min_income_inr": 1500000,  "label": "₹1-2 Cr SA → ₹15L min income"},
      {"sa_max_inr":   50000000, "min_income_inr": 1500000,  "label": "₹2-5 Cr SA → ₹15L min income"},
      {"sa_max_inr":  100000000, "min_income_inr": 2500000,  "label": "₹5-10 Cr SA → ₹25L min income"},
      {"sa_max_inr":  250000000, "min_income_inr": 5000000,  "label": "₹10-25 Cr SA → ₹50L min income"},
      {"sa_max_inr": 9999999999, "min_income_inr": 10000000, "label": "Above ₹25 Cr SA → ₹1 Cr min income"}
    ],
    "valid_residential_status": [
      "Resident Indian",
      "RI",
      "Resident"
    ]
  },
  "foir_threshold_pct": 55,
  "max_per_life_crore": 100,
  "bank_stmt_months_min": 6,
  "salary_slip_months_min": 3,
  "rate_limiting": {
    "note": "Tuned 2026-05-26 for Sonnet 4.6 deployment with bumped quota: 2,501,000 tpm + 2,501 rpm. Previous values (80k/60) were causing 429 storms at concurrency=4.",
    "max_concurrent_requests": 16,
    "max_concurrent_per_case": 6,
    "max_retries": 5,
    "base_delay_sec": 2.0,
    "max_delay_sec": 60.0,
    "min_request_gap_ms": 50,
    "jitter": true,
    "azure_tpm_limit": 2501000,
    "azure_rpm_limit": 2501
  },
  "earned_income_heads": {
    "salary": true,
    "business_profession": true,
    "firm_remuneration": true,
