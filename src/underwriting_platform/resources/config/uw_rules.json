{
  "insurer": "TATA AIA Life Insurance",
  "version": "Feb-2026",
  "llm": {
    "backend": "azure_claude",
    "note": "Set LLM_BACKEND env var to override: 'claude' | 'azure_claude' | 'gemini'",
    "azure_claude": {
      "endpoint": "https://kaiseries-claude-resource.services.ai.azure.com/anthropic/",
      "api_key": "",
      "deployment": "claude-sonnet-4-6",
      "api_version": "2025-04-01-preview",
      "max_tokens": 4096,
      "note_endpoint": "Get endpoint from Azure AI Foundry portal \u2192 your resource \u2192 Overview \u2192 Target URI",
      "note_auth": "Set AZURE_CLAUDE_ENDPOINT + AZURE_CLAUDE_API_KEY in .env (preferred over hardcoding here)",
      "model_note": "Sonnet 4.6 deployment with bumped quota (2.5M tpm + 2.5k rpm as of 2026-05-26). Cheaper than Opus 4.6 \u2014 recommended for high-volume POC batches.",
      "note_client": "Uses AnthropicFoundry from anthropic SDK \u2014 handles Azure auth automatically"
    },
    "claude": {
      "model": "claude-sonnet-4-6",
      "max_tokens": 4096,
      "env_key": "ANTHROPIC_API_KEY",
      "model_note": "claude-sonnet-4-6 = latest Sonnet on Anthropic direct API"
    },
    "gemini": {
      "model": "gemini-2.0-flash",
      "max_output_tokens": 4096,
      "env_key": "GEMINI_API_KEY"
    }
  },
  "income_multiples": {
    "18-30": 35,
    "31-35": 30,
    "36-40": 25,
    "41-45": 20,
    "46-50": 15,
    "51-55": 10,
    "56-60": 5,
    "61-65": 0
  },
  "hlv_grids": {
    "_comment": "v3 §11 — three multiplier grids per Term UW Feb 2026 p.15. Base = single-life HLV ceiling; ADB-ATPD = accidental-death rider grid; CI-HC = critical-illness/hospital-cash rider grid.",
    "base": {
      "18-30": 35,
      "31-35": 30,
      "36-40": 25,
      "41-45": 20,
      "46-50": 15,
      "51-55": 10,
      "56-60": 5,
      "61-65": 5
    },
    "adb_atpd": {
      "_note": "Same as base for SA <= 3Cr. For SA > 3Cr: 15× @ 18-60, 5× @ 61-65.",
      "default_18-60": 15,
      "default_61-65": 5,
      "sa_threshold_cr": 3
    },
    "ci_hc": {
      "18-30": 12,
      "31-35": 12,
      "36-40": 10,
      "41-45": 10,
      "46-50": 7.5,
      "51-55": 5,
      "56-60": 0,
      "61-65": 0
    }
  },
  "profile_classifier": {
    "_comment": "v3 §2 #26 — drives Phase 2 conditional sections. 11 profiles.",
    "rules": [
      {"profile": "NRI", "if": {"residency_in": ["NRI", "PIO", "OCI"]}},
      {"profile": "Senior 61-65", "if": {"age_min": 61, "age_max": 65}},
      {"profile": "Homemaker", "if": {"employment_type": "Homemaker"}},
      {"profile": "Student", "if": {"employment_type": "Student"}},
      {"profile": "Agriculturist", "if": {"employment_type": "Agriculturist"}},
      {"profile": "Transgender", "if": {"gender": "Other"}},
      {"profile": "Business Insurance", "if": {"product_type_contains": "Keyman"}},
      {"profile": "Credit Protect", "if": {"product_type_contains": "Credit Protect"}},
      {"profile": "SEP-VTU", "if": {"product_type_contains": "Shubh Employee Protect"}},
      {"profile": "Standard Self-Employed", "if": {"employment_type_in": ["Self-Employed Professional", "Self-Employed Business"]}},
      {"profile": "Standard Salaried", "if": {"default": true}}
    ]
  },
  "bmi_bands": {
    "_comment": "v3 §2 #28 — boundaries per medical UW grid.",
    "underweight_max": 18.5,
    "normal_max": 24.9,
    "overweight_max": 29.9,
    "labels": {
      "Underweight": "<18.5",
      "Normal": "18.5-24.9",
      "Overweight": "25-29.9",
      "Obese": "30+"
    }
  },
  "pending_categories": {
    "_comment": "v3 — typed PENDING reasons rendered in the case-sheet Source column. External-integration categories (BUREAU, ASKME, CKYC, AML, PHONEPE, HR_SYSTEM, VAHAN, TRUAI) removed — documents are the sole source of truth.",
    "PENDING_PIN_MASTER": "PENDING — PIN master (negative-PIN list)",
    "PENDING_PRODUCT_MASTER": "PENDING — Product master config",
    "PENDING_CHANNEL_MASTER": "PENDING — Channel risk master config",
    "PENDING_INDUSTRY_GRID": "PENDING — Industry/Occupation risk grid",
    "PENDING_UW_INPUT": "PENDING — UW reviewer input",
    "PENDING_ENGINE_GAP_PHASE2": "PENDING — Phase 2 engine work",
    "PENDING_ENGINE_GAP_PHASE3": "PENDING — Phase 3 integration",
    "PENDING_DOC": "PENDING — document not submitted"
  },
